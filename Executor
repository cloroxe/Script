-- Bouton d'action
local CopyButton = Instance.new("TextButton")
CopyButton.Name = "CopyButton"
CopyButton.Parent = MainFrame
CopyButton.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
CopyButton.BackgroundTransparency = 0.900
CopyButton.Position = UDim2.new(0.5, -125, 0, 135)
CopyButton.Size = UDim2.new(0, 250, 0, 40)
CopyButton.Font = Enum.Font.GothamSemibold
CopyButton.Text = "Copy Link & Join"
CopyButton.TextColor3 = Color3.fromRGB(255, 255, 255)
CopyButton.TextSize = 15.000

-- Coins arrondis pour le bouton
local ButtonCorner = Instance.new("UICorner")
ButtonCorner.CornerRadius = UDim.new(0, 8)
ButtonCorner.Parent = CopyButton

-- Contour pour le bouton
local ButtonStroke = Instance.new("UIStroke")
ButtonStroke.Color = Color3.fromRGB(100, 100, 110)
ButtonStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
ButtonStroke.Parent = CopyButton

-- Fonctionnalité du bouton (Copie du lien + Animation)
CopyButton.MouseButton1Click:Connect(function()
    local groupLink = "https://www.roblox.et/communities/8917073275/Scriptbloxian"
    
    -- Copie le lien dans le presse-papier
    copyFunction(groupLink)
    
    -- Changement visuel pour indiquer que ça a marché
    CopyButton.Text = "Link Copied!"
    CopyButton.TextColor3 = Color3.fromRGB(100, 255, 100)
    ButtonStroke.Color = Color3.fromRGB(100, 255, 100)
    
    -- Attend un peu puis détruit cette interface (ici tu pourrais lancer la suite de ton script)
    task.wait(1.5)
    ScreenGui:Destroy()
    
    -- Mets ici le code pour charger ton vrai Panel
    -- print("Chargement du panel principal...")
end)

-- Animation de survol (Hover) pour le bouton
CopyButton.MouseEnter:Connect(function()
    game:GetService("TweenService"):Create(CopyButton, TweenInfo.new(0.2), {BackgroundTransparency = 0.8}):Play()
end)

CopyButton.MouseLeave:Connect(function()
    game:GetService("TweenService"):Create(CopyButton, TweenInfo.new(0.2), {BackgroundTransparency = 0.9}):Play()
end)
