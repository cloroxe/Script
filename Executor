-- Service pour récupérer le joueur local
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Fonction de copie (compatible avec la plupart des exécuteurs)
local copyFunction = setclipboard or toclipboard or function(text)
    warn("La fonction setclipboard n'est pas supportée par cet exécuteur.")
end

-- Création de l'interface principale (ScreenGui)
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "PanelAccessUI"
ScreenGui.ResetOnSpawn = false
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

-- Tentative de le placer dans CoreGui pour ne pas être vu dans les logs, sinon PlayerGui
local success = pcall(function()
    ScreenGui.Parent = game:GetService("CoreGui")
end)
if not success then
    ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
end

-- Cadre principal (Fenêtre noire)
local MainFrame = Instance.new("Frame")
MainFrame.Name = "MainFrame"
MainFrame.Parent = ScreenGui
MainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 25) -- Gris très sombre / Noir
MainFrame.Position = UDim2.new(0.5, -200, 0.5, -100)
MainFrame.Size = UDim2.new(0, 400, 0, 200)
MainFrame.BorderSizePixel = 0

-- Coins arrondis pour le cadre principal
local MainCorner = Instance.new("UICorner")
